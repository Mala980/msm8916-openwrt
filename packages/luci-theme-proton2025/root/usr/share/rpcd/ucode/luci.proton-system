'use strict';

import { readfile, writefile, lsdir, popen } from 'fs';
import { cursor } from 'uci';
import { connect } from 'ubus';

function readFileContent(path) {
	let content = readfile(path);
	return content ? trim(content) : null;
}

function parseReleaseValue(content, key) {
	if (!content || !key) return null;

	let pattern = key + "='";
	let start = index(content, pattern);
	if (start < 0) return null;

	let valueStart = start + length(pattern);
	let tail = substr(content, valueStart);
	let valueEnd = index(tail, "'");
	if (valueEnd < 0) return null;

	return substr(tail, 0, valueEnd);
}

function extractUrl(line) {
	if (!line) return null;

	let httpsStart = index(line, 'https://');
	let httpStart = index(line, 'http://');
	let start = httpsStart;

	if (start < 0 || (httpStart >= 0 && httpStart < start))
		start = httpStart;

	if (start < 0) return null;

	let tail = substr(line, start);
	let end = length(tail);

	for (let i = 0; i < length(tail); i++) {
		let ch = substr(tail, i, 1);
		if (ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n' || ch == '"' || ch == '\'' || ch == '#') {
			end = i;
			break;
		}
	}

	return substr(tail, 0, end);
}

function isCommentOrEmptyLine(line) {
	let normalized = trim(line || '');
	if (!normalized) return true;

	return index(normalized, '#') == 0;
}

function normalizePackageFeedUrl(url, packageArch) {
	if (!url || !packageArch) return null;

	let marker = '/packages/' + packageArch;
	let markerPos = index(url, marker);
	if (markerPos < 0) return null;

	return substr(url, 0, markerPos + length(marker)) + '/';
}

function findPackageFeedUrlInContent(content, packageArch) {
	if (!content || !packageArch) return null;

	for (let line in split(content, "\n")) {
		if (isCommentOrEmptyLine(line))
			continue;

		let url = extractUrl(line);
		let normalized = normalizePackageFeedUrl(url, packageArch);
		if (normalized) return normalized;
	}

	return null;
}

function buildFallbackPackageFeedUrl(packageArch, releaseVersion) {
	let normalizedRelease = trim(releaseVersion || '');
	if (!normalizedRelease || !packageArch) return null;

	if (normalizedRelease == 'SNAPSHOT' || normalizedRelease == 'snapshot')
		return 'https://downloads.openwrt.org/snapshots/packages/' + packageArch + '/';

	let firstChar = substr(normalizedRelease, 0, 1);
	if (index('0123456789', firstChar) == 0 || index('0123456789', firstChar) > 0)
		return 'https://downloads.openwrt.org/releases/' + normalizedRelease + '/packages/' + packageArch + '/';

	return null;
}

function findPackageFeedUrl(packageArch, releaseVersion) {
	let directFiles = [
		'/etc/opkg/distfeeds.conf',
		'/etc/opkg/customfeeds.conf',
		'/etc/apk/repositories',
		'/etc/apk/distfeeds.list',
		'/etc/apk/repositories.d/distfeeds.list'
	];

	for (let path in directFiles) {
		let content = readFileContent(path);
		let url = findPackageFeedUrlInContent(content, packageArch);
		if (url) return url;
	}

	let repoFiles = lsdir('/etc/apk/repositories.d');
	if (repoFiles) {
		for (let name in repoFiles) {
			let content = readFileContent('/etc/apk/repositories.d/' + name);
			let url = findPackageFeedUrlInContent(content, packageArch);
			if (url) return url;
		}
	}

	return buildFallbackPackageFeedUrl(packageArch, releaseVersion);
}

function getSystemInfo() {
	let release = readFileContent('/etc/openwrt_release') || '';
	let packageArch = parseReleaseValue(release, 'DISTRIB_ARCH');
	let releaseVersion = parseReleaseValue(release, 'DISTRIB_RELEASE');

	return {
		package_arch: packageArch,
		target: parseReleaseValue(release, 'DISTRIB_TARGET'),
		package_feed_url: findPackageFeedUrl(packageArch, releaseVersion)
	};
}

function getBandInfo(earfcn) {
	let e = int(earfcn);
	if (e >= 0 && e <= 599) {
		return { code: "B1", freq: "2100", name: "Band 1 (2100 MHz - FDD)", dl: sprintf("%.1f MHz", 2110.0 + 0.1 * e), ul: sprintf("%.1f MHz", 1920.0 + 0.1 * e), duplex: "FDD" };
	} else if (e >= 600 && e <= 1199) {
		return { code: "B2", freq: "1900", name: "Band 2 (1900 MHz - FDD)", dl: sprintf("%.1f MHz", 1930.0 + 0.1 * (e - 600)), ul: sprintf("%.1f MHz", 1850.0 + 0.1 * (e - 600)), duplex: "FDD" };
	} else if (e >= 1200 && e <= 1949) {
		return { code: "B3", freq: "1800", name: "Band 3 (1800 MHz DCS - FDD)", dl: sprintf("%.1f MHz", 1805.0 + 0.1 * (e - 1200)), ul: sprintf("%.1f MHz", 1710.0 + 0.1 * (e - 1200)), duplex: "FDD" };
	} else if (e >= 1950 && e <= 2399) {
		return { code: "B4", freq: "1700/2100", name: "Band 4 (1700/2100 MHz AWS)", dl: sprintf("%.1f MHz", 2110.0 + 0.1 * (e - 1950)), ul: sprintf("%.1f MHz", 1710.0 + 0.1 * (e - 1950)), duplex: "FDD" };
	} else if (e >= 2400 && e <= 2649) {
		return { code: "B5", freq: "850", name: "Band 5 (850 MHz - FDD)", dl: sprintf("%.1f MHz", 869.0 + 0.1 * (e - 2400)), ul: sprintf("%.1f MHz", 824.0 + 0.1 * (e - 2400)), duplex: "FDD" };
	} else if (e >= 2750 && e <= 3449) {
		return { code: "B7", freq: "2600", name: "Band 7 (2600 MHz - FDD)", dl: sprintf("%.1f MHz", 2620.0 + 0.1 * (e - 2750)), ul: sprintf("%.1f MHz", 2500.0 + 0.1 * (e - 2750)), duplex: "FDD" };
	} else if (e >= 3450 && e <= 3799) {
		return { code: "B8", freq: "900", name: "Band 8 (900 MHz - FDD)", dl: sprintf("%.1f MHz", 925.0 + 0.1 * (e - 3450)), ul: sprintf("%.1f MHz", 880.0 + 0.1 * (e - 3450)), duplex: "FDD" };
	} else if (e >= 6150 && e <= 6449) {
		return { code: "B20", freq: "800", name: "Band 20 (800 MHz - FDD)", dl: sprintf("%.1f MHz", 791.0 + 0.1 * (e - 6150)), ul: sprintf("%.1f MHz", 832.0 + 0.1 * (e - 6150)), duplex: "FDD" };
	} else if (e >= 9210 && e <= 9659) {
		return { code: "B28", freq: "700", name: "Band 28 (700 MHz - FDD)", dl: sprintf("%.1f MHz", 758.0 + 0.1 * (e - 9210)), ul: sprintf("%.1f MHz", 703.0 + 0.1 * (e - 9210)), duplex: "FDD" };
	} else if (e >= 37750 && e <= 38249) {
		return { code: "B38", freq: "2600", name: "Band 38 (2600 MHz - TDD)", dl: sprintf("%.1f MHz", 2570.0 + 0.1 * (e - 37750)), ul: sprintf("%.1f MHz", 2570.0 + 0.1 * (e - 37750)), duplex: "TDD" };
	} else if (e >= 38650 && e <= 39649) {
		return { code: "B40", freq: "2300", name: "Band 40 (2300 MHz - TDD)", dl: sprintf("%.1f MHz", 2300.0 + 0.1 * (e - 38650)), ul: sprintf("%.1f MHz", 2300.0 + 0.1 * (e - 38650)), duplex: "TDD" };
	} else if (e >= 39650 && e <= 41589) {
		return { code: "B41", freq: "2500", name: "Band 41 (2500 MHz - TDD)", dl: sprintf("%.1f MHz", 2496.0 + 0.1 * (e - 39650)), ul: sprintf("%.1f MHz", 2496.0 + 0.1 * (e - 39650)), duplex: "TDD" };
	}
	// EARFCN outside the table above: report it, but don't invent a band.
	return { code: "", freq: "", name: "Unknown band (EARFCN " + earfcn + ")", dl: "--", ul: "--", duplex: "" };
}

function formatBytes(bytes) {
	let b = int(bytes);
	if (b >= 1073741824) return sprintf("%.2f GB", b / 1073741824.0);
	if (b >= 1048576) return sprintf("%.1f MB", b / 1048576.0);
	if (b >= 1024) return sprintf("%.1f KB", b / 1024.0);
	return sprintf("%d B", b);
}

function formatDuration(sec) {
	let s = int(sec);
	if (s < 0) s = 0;
	let d = int(s / 86400);
	let rem_d = s % 86400;
	let h = int(rem_d / 3600);
	let rem_h = rem_d % 3600;
	let m = int(rem_h / 60);
	let rem_s = rem_h % 60;
	return sprintf("%02dd %02dh:%02dm:%02ds", d, h, m, rem_s);
}

function hexToInt(hex) {
	if (!hex) return 0;
	let s = replace(hex, /^0x/i, "");
	let val = 0;
	for (let i = 0; i < length(s); i++) {
		let ch = uc(substr(s, i, 1));
		let d = index("0123456789ABCDEF", ch);
		if (d < 0) break;
		val = val * 16 + d;
	}
	return val;
}

function parseCellInfo() {
	let p_cell = popen("mmcli -m any --get-cell-info -J 2>/dev/null");
	let cell_raw = p_cell ? p_cell.read("all") : "";
	if (p_cell) p_cell.close();
	let cell_data = cell_raw ? json(cell_raw) : null;

	let serving = {
		band: "", freq: "", band_name: "", earfcn: "", pci: "",
		cell_id: "", cell_id_hex: "--", cell_id_dec: "--",
		enb: "--", sector: "--", tac: "", tac_hex: "--", tac_dec: "--",
		rsrp: "", rsrq: "", dl: "--", ul: "--", duplex: ""
	};
	let neighbors = [];

	if (cell_data && cell_data.modem && cell_data.modem.generic && cell_data.modem.generic["cell-info"]) {
		for (let line in cell_data.modem.generic["cell-info"]) {
			let is_serving = (index(line, "serving: yes") >= 0);
			let item = { earfcn: "", pci: "", rsrp: "", rsrq: "", cell_id: "", tac: "" };
			for (let token in split(line, ",")) {
				let p = split(trim(token), ":");
				if (length(p) >= 2) {
					let k = trim(p[0]), v = trim(p[1]);
					if (k == "earfcn") item.earfcn = v;
					else if (k == "physical ci") item.pci = v;
					else if (k == "ci") item.cell_id = v;
					else if (k == "tac") item.tac = v;
					else if (k == "rsrp") item.rsrp = sprintf("%.1f", int(v));
					else if (k == "rsrq") item.rsrq = sprintf("%.1f", int(v));
				}
			}
			// An empty EARFCN would parse as 0 and come out as B1.
			let b = (item.earfcn != "") ? getBandInfo(item.earfcn)
				: { code: "", freq: "", name: "", dl: "--", ul: "--", duplex: "" };
			item.band = b.code;
			item.freq = b.freq;
			item.band_name = b.name;
			item.dl = b.dl;
			item.ul = b.ul;
			item.duplex = b.duplex;

			if (is_serving) {
				serving = item;
				if (item.cell_id) {
					let cid_int = hexToInt(item.cell_id);
					if (cid_int > 0) {
						serving.cell_id_hex = "0x" + uc(item.cell_id);
						serving.cell_id_dec = sprintf("%d", cid_int);
						serving.enb = sprintf("%d", int(cid_int / 256));
						serving.sector = sprintf("%d", int(cid_int % 256));
					}
				}
				if (item.tac) {
					let tac_int = hexToInt(item.tac);
					serving.tac_hex = "0x" + uc(item.tac);
					serving.tac_dec = sprintf("%d", tac_int);
				}
			} else {
				push(neighbors, item);
			}
		}
	}
	return { serving: serving, neighbors: neighbors };
}

function parseSignalInfo() {
	let p_sig = popen("mmcli -m any --signal-get -J 2>/dev/null");
	let sig_raw = p_sig ? p_sig.read("all") : "";
	if (p_sig) p_sig.close();
	let sig_data = sig_raw ? json(sig_raw) : null;
	let rssi = "", snr = "", rsrp = "", rsrq = "";
	if (sig_data && sig_data.modem && sig_data.modem.signal && sig_data.modem.signal.lte) {
		let lte = sig_data.modem.signal.lte;
		if (lte.rssi && lte.rssi != "--") rssi = sprintf("%.1f", int(lte.rssi));
		if (lte.snr && lte.snr != "--") snr = sprintf("%.1f", lte.snr);
		if (lte.rsrp && lte.rsrp != "--") rsrp = sprintf("%.1f", int(lte.rsrp));
		if (lte.rsrq && lte.rsrq != "--") rsrq = sprintf("%.1f", int(lte.rsrq));
	}

	// Fallback to QMI direct query if mmcli polling returns empty
	if (!rssi || !snr) {
		let p_qmi = popen("qmicli -p -d /dev/wwan0qmi0 --nas-get-signal-info 2>/dev/null");
		let qmi_raw = p_qmi ? p_qmi.read("all") : "";
		if (p_qmi) p_qmi.close();

		for (let line in split(qmi_raw, "\n")) {
			let t = trim(line);
			let m_rssi = match(t, /^RSSI:\s*'([-\.0-9]+)\s*dBm'/);
			if (m_rssi) rssi = m_rssi[1];
			let m_snr = match(t, /^SNR:\s*'([-\.0-9]+)\s*dB'/);
			if (m_snr) snr = m_snr[1];
			let m_rsrp = match(t, /^RSRP:\s*'([-\.0-9]+)\s*dBm'/);
			if (m_rsrp && !rsrp) rsrp = m_rsrp[1];
			let m_rsrq = match(t, /^RSRQ:\s*'([-\.0-9]+)\s*dB'/);
			if (m_rsrq && !rsrq) rsrq = m_rsrq[1];
		}
	}

	return { rssi: rssi, snr: snr, rsrp: rsrp, rsrq: rsrq };
}

function getCarrierSession() {
	let ip = "--", gw = "--", dns = [], uptime_sec = 0;
	try {
		let ub = connect();
		let st = ub ? ub.call("network.interface.modem", "status", {}) : null;
		if (st) {
			uptime_sec = st.uptime || 0;
			if (st["ipv4-address"] && length(st["ipv4-address"]) > 0) {
				let a = st["ipv4-address"][0];
				ip = a.address + (a.mask ? "/" + a.mask : "");
			}
			if (st.route && length(st.route) > 0) {
				gw = st.route[0].nexthop || "--";
			}
			if (st["dns-server"]) dns = st["dns-server"];
		}
	} catch(e) {}

	let rx_bytes = trim(readfile("/sys/class/net/wwan0/statistics/rx_bytes") || "0");
	let tx_bytes = trim(readfile("/sys/class/net/wwan0/statistics/tx_bytes") || "0");

	let apn = "--";
	try {
		let u = cursor();
		if (u) {
			u.load("network");
			apn = u.get("network", "modem", "apn") || "--";
		}
	} catch(e) {}

	return {
		apn: apn,
		ip: ip,
		gateway: gw,
		dns: dns,
		mtu: int(trim(readfile("/sys/class/net/wwan0/mtu") || "0")) || "--",
		uptime: formatDuration(uptime_sec),
		rx: formatBytes(rx_bytes),
		tx: formatBytes(tx_bytes)
	};
}

// Modem DSP (remoteproc "4080000.remoteproc") state, recovery mode and crash
// count since boot, from sysfs and the kernel log -- nothing assumed.
function getModemWatchdog() {
	let rp = null;
	for (let d in (lsdir("/sys/class/remoteproc") || [])) {
		if (index(readFileContent("/sys/class/remoteproc/" + d + "/name") || "", "4080000") == 0) {
			rp = "/sys/class/remoteproc/" + d;
			break;
		}
	}
	if (!rp) return "--";

	let st = readFileContent(rp + "/state") || "unknown";
	let rec = readFileContent(rp + "/recovery");
	let crashes = 0;
	let p = popen("dmesg 2>/dev/null | grep -c 'crash detected in 4080000'");
	if (p) { crashes = int(trim(p.read("all") || "0")); p.close(); }

	return sprintf("Modem DSP %s%s, %d crash%s since boot", st,
		rec ? ", recovery " + rec : "", crashes, crashes == 1 ? "" : "es");
}

// IMEI / SIM details barely change, but Change IMEI rewrites the IMEI at
// runtime, so the cache must expire instead of living until reboot.
const HW_CACHE = "/tmp/.modem_hw_cache.json";
const HW_TTL = 30;

function getHardwareProfile() {
	let cached = readfile(HW_CACHE);
	if (cached) {
		let j = json(cached);
		if (j && j.imei && j.imei != "--" && time() - int(j.ts || 0) < HW_TTL) {
			j.watchdog = getModemWatchdog();
			return j;
		}
	}

	let p_sim = popen("mmcli -i any --output-keyvalue 2>/dev/null");
	let sim_raw = p_sim ? p_sim.read("all") : "";
	if (p_sim) p_sim.close();
	let imsi = "--", iccid = "--";
	for (let line in split(sim_raw, "\n")) {
		let p = split(line, ":");
		if (length(p) >= 2) {
			let k = trim(p[0]), v = trim(join(":", slice(p, 1)));
			if (k == "sim.properties.imsi") imsi = v;
			else if (k == "sim.properties.iccid") iccid = v;
		}
	}

	let p_m = popen("mmcli -m any --output-keyvalue 2>/dev/null");
	let m_raw = p_m ? p_m.read("all") : "";
	if (p_m) p_m.close();
	let imei = "--", fw_revision = "--";
	for (let line in split(m_raw, "\n")) {
		let p = split(line, ":");
		if (length(p) >= 2) {
			let k = trim(p[0]), v = trim(join(":", slice(p, 1)));
			if (k == "modem.3gpp.imei") imei = v;
			else if (k == "modem.generic.revision") fw_revision = v;
		}
	}

	let hw = {
		model: "Qualcomm Snapdragon 410 (MSM8916)",
		imei: imei,
		imsi: imsi,
		iccid: iccid,
		revision: fw_revision,
		ts: time()
	};
	if (imei != "--") writefile(HW_CACHE, sprintf("%J\n", hw));
	hw.watchdog = getModemWatchdog();
	return hw;
}

// Raw operator name straight from the modem: the quoted <oper> field of
// `AT+COPS?` in long alphanumeric format (e.g. "INDOSATOOREDOO").
// Returns the name, "" when the modem answers but is not registered (no
// <oper> field), or null when the AT command itself fails -- the caller then
// falls back to ModemManager's operator-name. Requires ModemManager --debug
// (always set by /etc/init.d/modemmanager). Cached briefly because the status
// bar polls every 2.5 s per open tab.
const COPS_CACHE = "/tmp/.proton_cops_cache";
const COPS_TTL = 15;

function atCommand(cmd) {
	let p = popen(sprintf("mmcli -m any --command='%s' 2>/dev/null", cmd));
	let out = p ? p.read("all") : "";
	if (p) p.close();
	let m = match(out || "", /response: '(.*)'/);
	return m ? m[1] : null;
}

function getRawOperatorName() {
	let now = time();
	let cached = readfile(COPS_CACHE);
	if (cached) {
		let c = split(trim(cached), "\t");
		if (length(c) >= 1 && now - int(c[0]) < COPS_TTL)
			return length(c) >= 2 ? c[1] : "";
	}

	let resp = atCommand("AT+COPS?");
	if (resp == null) return null;

	// +COPS: <mode>[,<format>,"<oper>"[,<AcT>]]
	let m = match(resp, /\+COPS: *[0-9]+, *([0-9]+), *"([^"]*)"/);
	if (m && m[1] != "0") {
		// Someone switched the response format to short/numeric; restore long.
		atCommand("AT+COPS=3,0");
		resp = atCommand("AT+COPS?");
		m = resp ? match(resp, /\+COPS: *[0-9]+, *([0-9]+), *"([^"]*)"/) : null;
	}

	let name = (m && m[1] == "0") ? trim(m[2]) : "";
	writefile(COPS_CACHE, sprintf("%d\t%s\n", now, name));
	return name;
}

// SMS inbox + unread counts for the status bar. smsctl greps the JSONL
// archive; cache briefly because getTelemetry is polled every 2.5 s per tab.
const SMS_CACHE = "/tmp/.proton_sms_cache";
const SMS_TTL = 10;

function getSmsCounts() {
	let now = time();
	let cached = readfile(SMS_CACHE);
	if (cached) {
		let c = split(trim(cached), "\t");
		if (length(c) >= 3 && now - int(c[0]) < SMS_TTL)
			return { inbox: int(c[1]), unread: int(c[2]) };
	}

	let inbox = 0, unread = 0;
	let p = popen("smsctl counts 2>/dev/null");
	let raw = p ? p.read("all") : "";
	if (p) p.close();
	let mi = match(raw || "", /"inbox" *: *([0-9]+)/);
	let mu = match(raw || "", /"unread" *: *([0-9]+)/);
	if (mi) inbox = int(mi[1]);
	if (mu) unread = int(mu[1]);

	writefile(SMS_CACHE, sprintf("%d\t%d\t%d\n", now, inbox, unread));
	return { inbox: inbox, unread: unread };
}

// Status-bar cellular summary: what the modem is really doing, never a guess.
//   rat     "4G" / "3G" / "2G" from ModemManager's access technology ("" if unknown)
//   band    "B3" etc. only when the serving cell's EARFCN was actually read
//   label   "4G B3", "4G", "No Service" (not registered) or "—" (no modem)
//   bars    0-5. LTE: from RSRP, minus 1 if SNR < 0 dB, minus 2 if SNR < -5 dB
//           (min 1). Otherwise ModemManager's RSSI-based signal quality.
//           0 whenever not registered.
// ModemManager's signal-quality % is RSSI-based and reads 80 %+ on a cell
// with RSRP -112 dBm / SNR -9 dB, so it is only the fallback.
function ratFromAccessTech(at) {
	at = lc(at || "");
	if (match(at, /lte|5gnr/)) return "4G";
	if (match(at, /umts|hsdpa|hsupa|hspa|tds/)) return "3G";
	if (match(at, /gsm|gprs|edge/)) return "2G";
	return "";
}

function lteBars(rsrp, snr) {
	let r = +rsrp;
	let bars = (r >= -85) ? 5 : (r >= -95) ? 4 : (r >= -105) ? 3 : (r >= -115) ? 2 : 1;
	if (snr != null && snr != "") {
		let s = +snr;
		if (s < -5) bars -= 2;
		else if (s < 0) bars -= 1;
	}
	return bars < 1 ? 1 : bars;
}

function qualityBars(q) {
	q = int(q);
	return (q > 80) ? 5 : (q > 60) ? 4 : (q > 40) ? 3 : (q > 20) ? 2 : (q > 0) ? 1 : 0;
}

function cellStatus(c) {
	if (!c.have_modem)
		return { rat: "", band: "", label: "—", service: false, bars: 0 };

	let registered = (c.reg_state == "home" || c.reg_state == "roaming");
	if (!registered)
		return { rat: "", band: "", label: "No Service", service: false, bars: 0 };

	let rat = ratFromAccessTech(c.access_tech);
	// An empty EARFCN parses as 0 and getBandInfo() would call it B1.
	let band = (c.earfcn != null && c.earfcn != "" && c.band) ? c.band : "";
	if (rat == "") rat = band ? "4G" : "";

	let bars = (rat == "4G" && c.rsrp != null && c.rsrp != "") ? lteBars(c.rsrp, c.snr) : qualityBars(c.signal);
	let label = rat ? (band ? rat + " " + band : rat) : (band || "—");

	return { rat: rat, band: band, label: label, service: true, bars: bars };
}

function getTelemetry() {
	// 1. CPU Temperature
	let temp_raw = readfile("/sys/class/thermal/thermal_zone3/temp") || readfile("/sys/class/thermal/thermal_zone4/temp") || "0";
	let temp = sprintf("%.1f", int(trim(temp_raw)) / 1000.0);

	// 2. RAM Usage
	let mem_raw = readfile("/proc/meminfo") || "";
	let total_kb = 0, avail_kb = 0;
	for (let line in split(mem_raw, "\n")) {
		let parts = split(line, ":");
		if (parts[0] == "MemTotal") total_kb = int(trim(parts[1]));
		else if (parts[0] == "MemAvailable") avail_kb = int(trim(parts[1]));
	}
	let used_kb = total_kb - avail_kb;
	let ram_pct = total_kb ? int((used_kb * 100) / total_kb) : 0;
	let ram_used_mb = int(used_kb / 1024);
	let ram_total_mb = int(total_kb / 1024);

	// 3. CPU % Usage
	let stat = readfile("/proc/stat") || "";
	let cpu_line = split(stat, "\n")[0] || "";
	let c = split(cpu_line, " ");
	let nums = [];
	for (let item in c) if (item != "" && item != "cpu") push(nums, int(item));
	let total_cpu = 0; for (let n in nums) total_cpu += n;
	let idle_cpu = (length(nums) >= 4) ? (nums[3] + (nums[4] || 0)) : 0;

	let last = readfile("/tmp/.cpu_telemetry") || "";
	let lp = split(trim(last), " ");
	let cpu_pct = 0;
	if (length(lp) >= 2) {
		let dt = total_cpu - int(lp[0]);
		let di = idle_cpu - int(lp[1]);
		if (dt > 0) cpu_pct = int(((dt - di) * 100) / dt);
	}
	writefile("/tmp/.cpu_telemetry", sprintf("%d %d\n", total_cpu, idle_cpu));

	// 4. Clients Count
	let leases = readfile("/tmp/dhcp.leases") || "";
	let client_count = 0;
	for (let l in split(leases, "\n")) {
		if (trim(l) != "") client_count++;
	}

	// 5. Modem & Cell Info
	let cell_res = parseCellInfo();
	let serving = cell_res.serving;
	let sig_res = parseSignalInfo();

	let p_kv = popen("mmcli -m any --output-keyvalue 2>/dev/null");
	let kv_raw = p_kv ? p_kv.read("all") : "";
	if (p_kv) p_kv.close();

	let have_modem = (trim(kv_raw || "") != "");
	let op_name = "", signal_val = 0, state = have_modem ? "unknown" : "absent";
	let access_tech = "", reg_state = "";
	for (let line in split(kv_raw, "\n")) {
		let p = split(line, ":");
		if (length(p) >= 2) {
			let k = trim(p[0]), v = trim(join(":", slice(p, 1)));
			if (k == "modem.3gpp.operator-name" && v != "--" && v != "") op_name = v;
			else if (k == "modem.generic.signal-quality.value") signal_val = int(v);
			else if (k == "modem.generic.state") state = v;
			else if (k == "modem.3gpp.registration-state") reg_state = v;
			// Plain "lte" / "umts, hsdpa", or a ".value[N]" list on some mmcli builds.
			else if ((k == "modem.generic.access-technologies" || index(k, "modem.generic.access-technologies.value[") == 0) && v != "--" && v != "")
				access_tech = access_tech ? access_tech + ", " + v : v;
		}
	}

	// Prefer the raw AT+COPS? name; "" (not registered) shows "Searching" in
	// the UI instead of a numeric PLMN such as "510 09".
	let raw_op = getRawOperatorName();
	if (raw_op != null) op_name = raw_op;

	let rsrp = sig_res.rsrp || serving.rsrp || "";
	let rsrq = sig_res.rsrq || serving.rsrq || "";

	let cell = cellStatus({
		have_modem: have_modem,
		reg_state: reg_state,
		access_tech: access_tech,
		earfcn: serving.earfcn,
		band: serving.band,
		rsrp: rsrp,
		snr: sig_res.snr,
		signal: signal_val
	});

	// ModemManager keeps the last operator name after the modem drops off the
	// network; with no service the UI shows "Searching" instead.
	if (!cell.service) op_name = "";

	let res = {
		operator: op_name,
		signal: signal_val,
		bars: cell.bars,
		rat: cell.rat,
		label: cell.label,
		service: cell.service,
		reg_state: reg_state,
		band: cell.band,
		earfcn: serving.earfcn || "",
		pci: serving.pci || "",
		cell_id: serving.cell_id || "",
		tac: serving.tac || "",
		rsrp: rsrp,
		rsrq: rsrq,
		rssi: sig_res.rssi || "",
		snr: sig_res.snr || "",
		state: state,
		temp: temp,
		cpu_pct: cpu_pct,
		ram_pct: ram_pct,
		ram_used: ram_used_mb,
		ram_total: ram_total_mb,
		clients: client_count
	};

	let sms = getSmsCounts();
	res.sms_inbox = sms.inbox;
	res.sms_unread = sms.unread;

	writefile("/tmp/.telemetry_cache.json", sprintf("%J\n", res));
	return res;
}

// Registration as the baseband itself reports it (QMI NAS serving system):
// the PLMN the radio is camped on, and whether service there is limited or
// forbidden. This is what explains "signal but no service".
function parseServingSystem() {
	let p = popen("qmicli -p -d /dev/wwan0qmi0 --nas-get-serving-system 2>/dev/null");
	let raw = p ? p.read("all") : "";
	if (p) p.close();

	let r = { state: "", plmn: "", status: "", forbidden: false };
	let mcc = "", mnc = "";
	for (let line in split(raw || "", "\n")) {
		let t = trim(line);
		let m = match(t, /^Registration state: '([^']*)'/);
		if (m) r.state = m[1];
		m = match(t, /^MCC: '([0-9]+)'/);
		if (m && mcc == "") mcc = m[1];
		m = match(t, /^MNC: '([0-9]+)'/);
		if (m && mnc == "") mnc = m[1];
		m = match(t, /^Status: '([^']*)'/);
		if (m) r.status = m[1];
		m = match(t, /^Forbidden: '([^']*)'/);
		if (m) r.forbidden = (m[1] == "yes");
	}
	if (mcc != "" && mnc != "") r.plmn = mcc + (length(mnc) == 1 ? "0" + mnc : mnc);
	return r;
}

// Network selection (see netselect in /lib/netifd/proto/modemmanager.sh):
// "home" (default) = only the SIM's own network, "auto", "manual" = 'plmn'.
const THREE_DIGIT_MNC_MCC = [ "302", "310", "311", "312", "313", "314", "315", "316", "334", "338", "342", "344", "346", "348", "350", "352", "354", "356", "358", "360", "365", "366", "376", "708", "722", "732" ];

function homePlmnFromImsi(imsi) {
	if (!match(imsi || "", /^[0-9]{6,15}$/)) return "";
	let mcc = substr(imsi, 0, 3);
	return substr(imsi, 0, (index(THREE_DIGIT_MNC_MCC, mcc) >= 0) ? 6 : 5);
}

function getNetworkSelection(imsi) {
	let mode = "", plmn = "";
	try {
		let u = cursor();
		u.load("network");
		mode = u.get("network", "modem", "netselect") || "";
		plmn = u.get("network", "modem", "plmn") || "";
	} catch(e) {}
	if (mode == "") mode = (plmn != "") ? "manual" : "home";
	return { mode: mode, plmn: plmn, home_plmn: homePlmnFromImsi(imsi) };
}

function setNetworkSelection(params) {
	let mode = params ? params.mode : null;
	let plmn = params ? (params.plmn || "") : "";
	if (mode != "home" && mode != "auto" && mode != "manual")
		return { success: false, error: "mode must be home, auto or manual" };
	if (mode == "manual" && !match(plmn, /^[0-9]{5,6}$/))
		return { success: false, error: "manual mode needs a 5 or 6 digit PLMN (MCC+MNC)" };

	let u = cursor();
	u.load("network");
	if (!u.get("network", "modem"))
		return { success: false, error: "no network.modem interface" };
	u.set("network", "modem", "netselect", mode);
	if (mode == "manual") u.set("network", "modem", "plmn", plmn);
	else u.delete("network", "modem", "plmn");
	u.commit("network");

	// A new choice starts with a clean home-network failure count, then the
	// modem interface setup is re-run so it applies now.
	system("rm -f /tmp/mm-netselect-modem; (ifup modem) >/dev/null 2>&1 &");
	return { success: true, mode: mode, plmn: (mode == "manual") ? plmn : "" };
}

function getSignalDetails() {
	let cell_res = parseCellInfo();
	let sig_res = parseSignalInfo();
	let serving = cell_res.serving;

	if (sig_res.rsrp && !serving.rsrp) serving.rsrp = sig_res.rsrp;
	if (sig_res.rsrq && !serving.rsrq) serving.rsrq = sig_res.rsrq;

	// Delta calculation for neighbor cells
	let s_rsrp_num = int(serving.rsrp || -140);
	for (let n in cell_res.neighbors) {
		let n_rsrp = int(n.rsrp || -140);
		let diff = n_rsrp - s_rsrp_num;
		n.delta = (diff > 0 ? "+" : "") + sprintf("%d dB", diff);
	}

	let p_kv = popen("mmcli -m any --output-keyvalue 2>/dev/null");
	let kv_raw = p_kv ? p_kv.read("all") : "";
	if (p_kv) p_kv.close();

	let current_bands = [];
	let op_name = "", op_code = "", sig_quality = 0, state = (trim(kv_raw || "") != "") ? "unknown" : "absent", reg_state = "unknown";

	for (let line in split(kv_raw, "\n")) {
		let p = split(line, ":");
		if (length(p) >= 2) {
			let k = trim(p[0]), v = trim(join(":", slice(p, 1)));
			if (index(k, "modem.generic.current-bands.value[") == 0) push(current_bands, v);
			else if (k == "modem.3gpp.operator-name") op_name = v;
			else if (k == "modem.3gpp.operator-code") op_code = v;
			else if (k == "modem.3gpp.registration-state") reg_state = v;
			else if (k == "modem.generic.signal-quality.value") sig_quality = int(v);
			else if (k == "modem.generic.state") state = v;
		}
	}

	let saved_uci_bands = null;
	try {
		let u = cursor();
		if (u) {
			u.load("network");
			saved_uci_bands = u.get("network", "modem", "bands");
		}
	} catch(e) {}

	let bearer = getCarrierSession();
	let hw = getHardwareProfile();
	let reg = parseServingSystem();

	// ModemManager keeps the last operator name/code after the modem drops
	// off the network; only trust them while actually registered.
	let registered = (reg_state == "home" || reg_state == "roaming");
	if (!registered) { op_name = ""; op_code = ""; }
	if (op_name == "--") op_name = "";
	if (op_code == "--") op_code = "";

	// The old IP/route stay on the interface until netifd notices; flag them.
	bearer.stale = !registered && bearer.ip != "--";

	// 3GPP TS 27.007 CSQ from the measured RSSI: (RSSI + 113) / 2, 0..31.
	let csq = "--";
	if (sig_res.rssi != "") {
		let c = int((+sig_res.rssi + 113) / 2);
		csq = c < 0 ? 0 : (c > 31 ? 31 : c);
	}

	return {
		operator: {
			name: op_name,
			code: op_code,
			state: state,
			reg_state: reg_state,
			registered: registered
		},
		registration: reg,
		netselect: getNetworkSelection(hw.imsi),
		signal: {
			percent: sig_quality,
			csq: csq,
			rsrp: serving.rsrp || "--",
			rsrq: serving.rsrq || "--",
			rssi: sig_res.rssi || "--",
			snr: sig_res.snr || "--"
		},
		serving: serving,
		bearer: bearer,
		hardware: hw,
		current_bands: current_bands,
		persisted_bands: saved_uci_bands || "all",
		neighbors: cell_res.neighbors
	};
}

function getTTL() {
	let enabled = false;
	let value = 64;
	try {
		let u = cursor();
		if (u) {
			u.load("firewall");
			u.foreach("firewall", "include", function(s) {
				if (s.path == "/etc/firewall.ttl") {
					enabled = true;
				}
			});
		}
	} catch(e) {}

	let f_content = readfile("/etc/firewall.ttl");
	if (f_content) {
		let m = match(f_content, /ip ttl set ([0-9]+)/);
		if (m) value = int(m[1]);
	}

	return {
		enabled: enabled,
		value: value
	};
}

function setTTL(params) {
	let enabled = params && (params.enabled == 1 || params.enabled == "1" || params.enabled === true);
	let value = params && params.value ? int(params.value) : 64;
	if (value <= 0 || value > 255) value = 64;

	if (enabled) {
		let nft_script = sprintf(
			"table inet fw4 {\n" +
			"    chain mangle_forward_ttl {\n" +
			"        type filter hook forward priority mangle; policy accept;\n" +
			"        ip ttl set %d\n" +
			"        ip6 hoplimit set %d\n" +
			"    }\n" +
			"}\n", value, value
		);
		writefile("/etc/firewall.ttl", nft_script);

		try {
			let u = cursor();
			if (u) {
				u.load("firewall");
				let found = false;
				u.foreach("firewall", "include", function(s) {
					if (s.path == "/etc/firewall.ttl") found = true;
				});
				if (!found) {
					let sid = u.add("firewall", "include");
					u.set("firewall", sid, "path", "/etc/firewall.ttl");
					u.set("firewall", sid, "type", "nftables");
					u.set("firewall", sid, "position", "ruleset-append");
					u.commit("firewall");
				}
			}
		} catch(e) {}

		system("nft -f /etc/firewall.ttl 2>/dev/null || /etc/init.d/firewall restart >/dev/null 2>&1");
	} else {
		try {
			let u = cursor();
			if (u) {
				u.load("firewall");
				u.foreach("firewall", "include", function(s) {
					if (s.path == "/etc/firewall.ttl") {
						u.delete("firewall", s[".name"]);
					}
				});
				u.commit("firewall");
			}
		} catch(e) {}

		system("rm -f /etc/firewall.ttl && nft delete chain inet fw4 mangle_forward_ttl 2>/dev/null || /etc/init.d/firewall restart >/dev/null 2>&1");
	}

	return { success: true, enabled: enabled, value: value };
}

function setBandLock(params) {
	let bands = params ? params.bands : null;
	let is_auto = (!bands || bands == "all" || bands == "AUTO");
	if (is_auto) {
		bands = "eutran-1|eutran-3|eutran-5|eutran-7|eutran-8|eutran-20|eutran-38|eutran-40|eutran-41|utran-1|utran-8";
	}
	let clean_bands = replace(bands, "'", "");

	// Persist to UCI network.modem.bands so it survives reboots
	try {
		let u = cursor();
		if (u) {
			u.load("network");
			if (is_auto) {
				u.delete("network", "modem", "bands");
			} else {
				u.set("network", "modem", "bands", clean_bands);
			}
			u.commit("network");
		}
	} catch(e) {}

	let cmd = sprintf("mmcli -m any --set-current-bands=\"%s\" 2>&1", clean_bands);
	let p = popen(cmd);
	let out = p ? p.read("all") : "";
	let rc = p ? p.close() : -1;
	return {
		success: (rc == 0 || index(out, "successfully") >= 0),
		output: trim(out),
		bands: clean_bands,
		persisted: !is_auto ? clean_bands : "all"
	};
}

// Speedtest CLI by Ookla: downloaded on request by ookla-speedtest-install
// (proprietary, personal use), installed as /usr/bin/speedtest.
const OOKLA_INSTALL_LOG = "/tmp/.ookla_install.log";
const OOKLA_INSTALL_RC = "/tmp/.ookla_install.rc";
const OOKLA_SERVERS_CACHE = "/tmp/.ookla_servers.json";
const OOKLA_SERVERS_TTL = 600;

function getOoklaStatus() {
	let p = popen("/usr/sbin/ookla-speedtest-install --status 2>/dev/null");
	let st = json((p ? p.read("all") : "") || "{}") || {};
	if (p) p.close();

	let rc = readfile(OOKLA_INSTALL_RC);
	let installing = (readfile(OOKLA_INSTALL_LOG) != null && rc == null);
	let error = "";
	if (rc != null && trim(rc) != "0") {
		for (let l in split(readfile(OOKLA_INSTALL_LOG) || "", "\n"))
			if (index(l, "error: ") == 0) error = substr(l, 7);
		if (error == "") error = "installation failed";
	}
	return {
		installed: !!st.installed,
		version: st.version || "",
		installing: installing,
		error: error,
		eula: "https://www.speedtest.net/about/eula",
		terms: "https://www.speedtest.net/about/terms",
		privacy: "https://www.speedtest.net/about/privacy"
	};
}

function installOokla(params) {
	if (!params || params.accept !== true)
		return { started: false, error: "the Speedtest CLI license must be accepted" };
	system(sprintf("rm -f %s %s; (/usr/sbin/ookla-speedtest-install --accept-license > %s 2>&1; echo $? > %s) >/dev/null 2>&1 &",
		OOKLA_INSTALL_LOG, OOKLA_INSTALL_RC, OOKLA_INSTALL_LOG, OOKLA_INSTALL_RC));
	return { started: true };
}

function removeOokla() {
	system(sprintf("/usr/sbin/ookla-speedtest-install --remove >/dev/null 2>&1; rm -f %s %s %s",
		OOKLA_INSTALL_LOG, OOKLA_INSTALL_RC, OOKLA_SERVERS_CACHE));
	return getOoklaStatus();
}

// Nearby Ookla servers (the CLI picks the nearest by default), cached.
function listOoklaServers() {
	let cached = json(readfile(OOKLA_SERVERS_CACHE) || "null");
	if (cached && cached.servers && length(cached.servers) && time() - int(cached.ts || 0) < OOKLA_SERVERS_TTL)
		return { servers: cached.servers };

	let p = popen("HOME=/root /usr/bin/speedtest --accept-license --accept-gdpr -L -f json 2>/dev/null");
	let raw = p ? p.read("all") : "";
	if (p) p.close();

	let out = [];
	for (let l in split(raw || "", "\n")) {
		let j = json(trim(l) || "null");
		if (j && type(j.servers) == "array") {
			for (let sv in j.servers)
				push(out, { id: sv.id, name: sv.name, location: sv.location, country: sv.country });
		}
	}
	if (length(out))
		writefile(OOKLA_SERVERS_CACHE, sprintf("%J\n", { ts: time(), servers: out }));
	return { servers: out, error: length(out) ? "" : "could not reach the Ookla server list" };
}

function startSpeedtest(params) {
	let gw = params ? (params.gateway || "cloudflare") : "cloudflare";
	let sz = params ? (params.size || "standard") : "standard";
	let chost = params ? (params.custom_host || "") : "";
	let cdown = params ? (params.custom_down_url || "") : "";
	let cup = params ? (params.custom_up_url || "") : "";

	// Kill existing test if running
	let pid_raw = readfile("/tmp/.speedtest.pid");
	if (pid_raw) {
		let old_pid = trim(pid_raw);
		let kp = popen(sprintf("kill -9 %s 2>/dev/null; killall speedtest 2>/dev/null", old_pid));
		if (kp) kp.close();
	}

	let cmd = sprintf("/usr/sbin/modem-speedtest '%s' '%s' '%s' '%s' '%s' >/dev/null 2>&1 &",
		replace(gw, "'", ""),
		replace(sz, "'", ""),
		replace(chost, "'", ""),
		replace(cdown, "'", ""),
		replace(cup, "'", "")
	);
	let p = popen(cmd);
	if (p) p.close();

	return { started: true, gateway: gw, size: sz };
}

function getSpeedtestStatus() {
	let raw = readfile("/tmp/.speedtest_status.json");
	if (raw) {
		let j = json(raw);
		if (j) return j;
	}
	return {
		state: "idle",
		step: "ready",
		step_label: "Ready to Test",
		progress: 0,
		ping_min: 0,
		ping_avg: 0,
		ping_max: 0,
		jitter: 0,
		packet_loss: 0,
		download_mbps: 0,
		upload_mbps: 0
	};
}

function getSpeedtestHistory() {
	let raw = readfile("/tmp/.speedtest_history.json");
	if (raw) {
		let j = json(raw);
		if (j) return j;
	}
	return [];
}

function cancelSpeedtest() {
	let pid_raw = readfile("/tmp/.speedtest.pid");
	if (pid_raw) {
		let pid = trim(pid_raw);
		let kp = popen(sprintf("kill -9 %s 2>/dev/null", pid));
		if (kp) kp.close();
		let pkill = popen("killall uclient-fetch ping speedtest 2>/dev/null");
		if (pkill) pkill.close();
	}
	writefile("/tmp/.speedtest_status.json", '{"state":"idle","step":"cancelled","progress":0}\n');
	return { cancelled: true };
}

function clearSpeedtestHistory() {
	writefile("/tmp/.speedtest_history.json", '[]\n');
	return { cleared: true };
}

