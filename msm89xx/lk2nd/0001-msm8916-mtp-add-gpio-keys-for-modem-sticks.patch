From: MSM89xx OpenWrt fork
Subject: [PATCH] msm8916: mtp: add modem stick device nodes with reset key

The 512 MB MTP bundle DTB is what lk1st uses for the MSM8916 modem sticks.
lk2nd can only react to a button that is described in the device node it
selects, so the upstream yiming-uz801-v3 node (which has no gpio-keys) can
never enter fastboot mode when the reset button is held at power-on.

Add gpio-keys to the uz801 node and add opt-in nodes for the boards that
have no upstream lk2nd node yet (UFI001B, UFI003, HMUF02-V5, UF02, MF800B).
Every key maps the reset button to KEY_HOME, which makes aboot.c set
boot_into_fastboot when the button is held during boot.

GPIO numbers and polarities come from the board DTS in this fork's kernel
tree (arch/arm64/boot/dts/qcom/msm8916-generic-*.dts and
msm8916-yiming-uz801v3.dts).
--- a/lk2nd/device/dts/msm8916/msm8916-512mb-mtp.dts
+++ b/lk2nd/device/dts/msm8916/msm8916-512mb-mtp.dts
@@ -87,6 +87,20 @@
 		lk2nd,match-cmdline = "* mdss_mdp.panel=1:dsi:0:qcom,mdss_dsi_jdi_1080p_video";
 
 		lk2nd,dtb-files = "msm8916-yiming-uz801v3";
+
+		gpio-keys {
+			compatible = "gpio-keys";
+			reset {
+				/*
+				 * Reset button on the stick (GPIO23, active low,
+				 * external pull-up) - see the kernel DTS
+				 * msm8916-yiming-uz801v3.dts. KEY_HOME makes lk2nd
+				 * enter fastboot mode when it is held at power-on.
+				 */
+				lk2nd,code = <KEY_HOME>;
+				gpios = <&tlmm 23 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
+			};
+		};
 	};
 
 	xiaoxun-jz0145-v33 {
@@ -110,4 +124,79 @@
 			};
 		};
 	};
+
+	/*
+	 * MSM89xx OpenWrt fork: device nodes for the modem sticks that have no
+	 * upstream lk2nd node. They expose only the reset button, as KEY_HOME,
+	 * so that holding it during power-on enters fastboot mode. GPIO number
+	 * and polarity are taken from the board DTS in this fork's kernel tree
+	 * (arch/arm64/boot/dts/qcom/msm8916-generic-*.dts).
+	 *
+	 * They are opt-in: a board only uses one of them when it is built with
+	 * the matching LK2ND_COMPATIBLE (see target/linux/msm89xx/image).
+	 */
+	msm89xx-ufi001b {
+		model = "UFI001B 4G Modem Stick";
+		compatible = "msm89xx,ufi001b";
+
+		gpio-keys {
+			compatible = "gpio-keys";
+			reset {
+				lk2nd,code = <KEY_HOME>;
+				gpios = <&tlmm 37 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
+			};
+		};
+	};
+
+	msm89xx-ufi003 {
+		model = "UFI003_MB_V02 4G Modem Stick";
+		compatible = "msm89xx,ufi003";
+
+		gpio-keys {
+			compatible = "gpio-keys";
+			reset {
+				lk2nd,code = <KEY_HOME>;
+				gpios = <&tlmm 37 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
+			};
+		};
+	};
+
+	msm89xx-hmuf02v5 {
+		model = "HMUF02-V5 4G Modem Stick";
+		compatible = "msm89xx,hmuf02v5";
+
+		gpio-keys {
+			compatible = "gpio-keys";
+			reset {
+				lk2nd,code = <KEY_HOME>;
+				gpios = <&tlmm 37 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
+			};
+		};
+	};
+
+	msm89xx-uf02 {
+		model = "UF02 4G Modem Stick";
+		compatible = "msm89xx,uf02";
+
+		gpio-keys {
+			compatible = "gpio-keys";
+			reset {
+				lk2nd,code = <KEY_HOME>;
+				gpios = <&tlmm 23 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
+			};
+		};
+	};
+
+	msm89xx-mf800b {
+		model = "MF800B 4G MiFi";
+		compatible = "msm89xx,mf800b";
+
+		gpio-keys {
+			compatible = "gpio-keys";
+			reset {
+				lk2nd,code = <KEY_HOME>;
+				gpios = <&tlmm 102 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
+			};
+		};
+	};
 };
