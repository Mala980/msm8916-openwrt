#!/bin/sh

[ "$DEVICENAME" = "phy0" ] || exit 0

# First-boot Wi-Fi defaults are set by msm-firmware-dumper / uci-defaults.
# Respect user-configured wireless.radio0.disabled / default_radio0.disabled across reboots.

#
# mf800b has no automatic LED indication: nothing claims its LEDs
# except the power button handler.
#
case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
	*mf800b*) exit 0 ;;
esac

# Green LED is reserved for WAN (wwan0) via netdev trigger
exit 0
