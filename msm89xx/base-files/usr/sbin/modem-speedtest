#!/bin/sh
# Router-side speedtest.
# Usage: modem-speedtest ookla [size-ignored] [ookla_server_id]
#        modem-speedtest cloudflare|custom [size: standard|fast|deep] [custom_host] [custom_down] [custom_up]

GATEWAY_ID="${1:-cloudflare}"
TEST_SIZE="${2:-standard}"
CUSTOM_HOST="$3"
CUSTOM_DOWN_URL="$4"
CUSTOM_UP_URL="$5"

STATE_DIR="${SPEEDTEST_STATE_DIR:-/tmp}"
SPEEDTEST_BIN="${SPEEDTEST_BIN:-/usr/bin/speedtest}"
OUTPUT_FILE="$STATE_DIR/.speedtest_status.json"
PID_FILE="$STATE_DIR/.speedtest.pid"
HIST_FILE="$STATE_DIR/.speedtest_history.json"
TELEMETRY_FILE="$STATE_DIR/.telemetry_cache.json"

echo "$$" > "$PID_FILE"

# Payload sizing 1:1 (Equal Download and Upload sizes)
DOWN_BYTES=10000000
UP_COUNT=160 # 160 * 64k = 10.48 MB (1:1 with 10MB Download)

if [ "$TEST_SIZE" = "fast" ]; then
    DOWN_BYTES=5000000
    UP_COUNT=80 # 80 * 64k = 5.24 MB (1:1 with 5MB Download)
elif [ "$TEST_SIZE" = "deep" ]; then
    DOWN_BYTES=25000000
    UP_COUNT=400 # 400 * 64k = 26.2 MB (1:1 with 25MB Download)
fi

# Read current active radio band & cell info (empty when not known)
ACTIVE_BAND=""
ACTIVE_OPERATOR=""
ACTIVE_RSRP=""
ACTIVE_SINR=""
if [ -s "$TELEMETRY_FILE" ]; then
    eval "$(jsonfilter -i "$TELEMETRY_FILE" \
        -e 'ACTIVE_BAND=@.label' -e 'ACTIVE_OPERATOR=@.operator' \
        -e 'ACTIVE_RSRP=@.rsrp' -e 'ACTIVE_SINR=@.snr' 2>/dev/null)"
fi

append_history() {
    ucode -e '
    import { readfile, writefile } from "fs";
    let h = json(readfile(ARGV[0]) || "[]") || [];
    let e = json(readfile(ARGV[1]));
    if (e && e.state == "completed") {
        unshift(h, e);
        if (length(h) > 10) h = slice(h, 0, 10);
        writefile(ARGV[0], sprintf("%J\n", h));
    }
    ' "$HIST_FILE" "$OUTPUT_FILE" 2>/dev/null || true
}

# --- Ookla engine -------------------------------------------------------------
# Runs the official Speedtest CLI (installed with ookla-speedtest-install) on
# the router itself, multi-connection, against a real Ookla server: the nearest
# one, or the server id given as the 3rd argument. Live progress comes from
# its JSON-lines output.
ookla_status() { # ookla_status <state> <step> <label> <progress>
    ucode -e '
    let a = ARGV;
    let num = (v) => (v == null || v == "") ? 0 : +v;
    let mbps = (bw) => (bw == null || bw == "") ? 0 : +sprintf("%.2f", (+bw) * 8 / 1000000);
    let e = {
        engine: "ookla", state: a[0], step: a[1], step_label: a[2], progress: +a[3],
        server: a[4] || "Ookla server", location: a[5], target: a[6], isp: a[7],
        band: a[8], operator: a[9], rsrp: a[10], sinr: a[11],
        ping_avg: num(a[12]), ping_min: num(a[13]), ping_max: num(a[14]), jitter: num(a[15]),
        packet_loss: num(a[16]),
        download_mbps: mbps(a[17]), upload_mbps: mbps(a[18]),
        result_url: a[19], error: a[20]
    };
    if (a[0] == "completed") e.timestamp = a[21];
    print(sprintf("%J\n", e));
    ' "$1" "$2" "$3" "$4" "$O_SERVER" "$O_LOCATION" "$O_HOST" "$O_ISP" \
      "$ACTIVE_BAND" "$ACTIVE_OPERATOR" "$ACTIVE_RSRP" "$ACTIVE_SINR" \
      "$O_PING" "$O_PING_LOW" "$O_PING_HIGH" "$O_JITTER" "$O_LOSS" \
      "$O_DOWN_BW" "$O_UP_BW" "$O_URL" "$O_ERROR" "$(date '+%Y-%m-%d %H:%M:%S')" \
      > "$OUTPUT_FILE.tmp" && mv -f "$OUTPUT_FILE.tmp" "$OUTPUT_FILE"
}

run_ookla() {
    local server_id="$1" line T P
    O_SERVER=""; O_LOCATION=""; O_HOST=""; O_ISP=""; O_PING=""; O_PING_LOW=""; O_PING_HIGH=""
    O_JITTER=""; O_LOSS=""; O_DOWN_BW=""; O_UP_BW=""; O_URL=""; O_ERROR=""

    if [ ! -x "$SPEEDTEST_BIN" ]; then
        O_ERROR="Speedtest CLI by Ookla is not installed (run ookla-speedtest-install --accept-license)"
        ookla_status failed error "$O_ERROR" 100
        rm -f "$PID_FILE"; exit 1
    fi

    ookla_status running start "Selecting the nearest Ookla server..." 5

    case "$server_id" in ''|*[!0-9]*) server_id="" ;; esac

    HOME=/root "$SPEEDTEST_BIN" --accept-license --accept-gdpr -f jsonl -p yes \
        ${server_id:+-s "$server_id"} 2>/dev/null |
    while IFS= read -r line; do
        T=""; P=""
        eval "$(jsonfilter -s "$line" -e 'T=@.type' 2>/dev/null)"
        case "$T" in
            testStart)
                eval "$(jsonfilter -s "$line" -e 'O_SERVER=@.server.name' -e 'O_LOCATION=@.server.location' \
                    -e 'O_HOST=@.server.host' -e 'O_ISP=@.isp' 2>/dev/null)"
                ookla_status running ping "Measuring latency to $O_SERVER ($O_LOCATION)..." 10
                ;;
            ping)
                eval "$(jsonfilter -s "$line" -e 'O_PING=@.ping.latency' -e 'O_JITTER=@.ping.jitter' -e 'P=@.ping.progress' 2>/dev/null)"
                ookla_status running ping "Measuring latency to $O_SERVER..." "$(awk -v p="${P:-0}" 'BEGIN{printf "%d", 10 + p * 20}')"
                ;;
            download)
                eval "$(jsonfilter -s "$line" -e 'O_DOWN_BW=@.download.bandwidth' -e 'P=@.download.progress' 2>/dev/null)"
                ookla_status running download "Measuring download speed..." "$(awk -v p="${P:-0}" 'BEGIN{printf "%d", 30 + p * 35}')"
                ;;
            upload)
                eval "$(jsonfilter -s "$line" -e 'O_UP_BW=@.upload.bandwidth' -e 'P=@.upload.progress' 2>/dev/null)"
                ookla_status running upload "Measuring upload speed..." "$(awk -v p="${P:-0}" 'BEGIN{printf "%d", 65 + p * 34}')"
                ;;
            result)
                eval "$(jsonfilter -s "$line" \
                    -e 'O_PING=@.ping.latency' -e 'O_PING_LOW=@.ping.low' -e 'O_PING_HIGH=@.ping.high' \
                    -e 'O_JITTER=@.ping.jitter' -e 'O_LOSS=@.packetLoss' \
                    -e 'O_DOWN_BW=@.download.bandwidth' -e 'O_UP_BW=@.upload.bandwidth' \
                    -e 'O_URL=@.result.url' -e 'O_SERVER=@.server.name' -e 'O_LOCATION=@.server.location' \
                    -e 'O_ISP=@.isp' 2>/dev/null)"
                ookla_status completed done "Speedtest by Ookla completed" 100
                ;;
            '')
                # e.g. {"error":"Cannot read: "} when the servers are unreachable
                eval "$(jsonfilter -s "$line" -e 'O_ERROR=@.error' 2>/dev/null)"
                ;;
            log|error)
                eval "$(jsonfilter -s "$line" -e 'P=@.level' -e 'O_ERROR=@.message' -e 'O_ERROR=@.error' 2>/dev/null)"
                [ "$T" = "error" ] || [ "$P" = "error" ] || O_ERROR=""
                ;;
        esac
        [ -n "$O_ERROR" ] && echo "$O_ERROR" > "$OUTPUT_FILE.err"
    done

    # The pipeline ran in a subshell: decide the outcome from the status file.
    if ! grep -q '"state": *"completed"' "$OUTPUT_FILE" 2>/dev/null; then
        O_ERROR="$(cat "$OUTPUT_FILE.err" 2>/dev/null)"
        [ -n "$O_ERROR" ] || O_ERROR="Speedtest by Ookla did not complete (no connection to the Ookla servers?)"
        ookla_status failed error "$O_ERROR" 100
    else
        append_history
    fi
    rm -f "$OUTPUT_FILE.err" "$PID_FILE"
    exit 0
}

[ "$GATEWAY_ID" = "ookla" ] && run_ookla "$CUSTOM_HOST"

# --- Cloudflare engine (single HTTP stream) -----------------------------------
# Older builds offered OpenIXP / Google / Singtel / Quad9 "servers" that all
# downloaded from Cloudflare and only pinged elsewhere; they map to Cloudflare.
SERVER_NAME="Cloudflare (speed.cloudflare.com)"
PING_TARGET="1.1.1.1"
DOWN_URL="https://speed.cloudflare.com/__down?bytes=$DOWN_BYTES"
UP_URL="https://speed.cloudflare.com/__up"
LOCATION="Nearest Cloudflare edge"

if [ "$GATEWAY_ID" = "custom" ]; then
    SERVER_NAME="Custom server ($CUSTOM_HOST)"
    [ -n "$CUSTOM_HOST" ] && PING_TARGET="$CUSTOM_HOST"
    [ -n "$CUSTOM_DOWN_URL" ] && DOWN_URL="$CUSTOM_DOWN_URL"
    [ -n "$CUSTOM_UP_URL" ] && UP_URL="$CUSTOM_UP_URL"
    LOCATION="Custom target"
fi

# Initialize Status
cat << JSON > "$OUTPUT_FILE"
{
  "state": "running",
  "step": "ping",
  "step_label": "[Phase 1/3] Analyzing Ping Latency & RFC 3550 Jitter...",
  "server": "$SERVER_NAME",
  "location": "$LOCATION",
  "target": "$PING_TARGET",
  "band": "$ACTIVE_BAND",
  "operator": "$ACTIVE_OPERATOR",
  "rsrp": "$ACTIVE_RSRP",
  "sinr": "$ACTIVE_SINR",
  "ping_min": 0,
  "ping_avg": 0,
  "ping_max": 0,
  "jitter": 0,
  "packet_loss": 0,
  "download_mbps": 0,
  "upload_mbps": 0,
  "progress": 15
}
JSON

# 1. PING & JITTER ANALYSIS (10 Probes)
PING_RAW=$(ping -c 10 -W 2 "$PING_TARGET" 2>&1)
TIMES=$(echo "$PING_RAW" | awk -F'time=' '/time=/ {print $2}' | awk '{print $1}')

COUNT=0
TOTAL=0
MIN=99999
MAX=0
PREV=""
DIFF_SUM=0
DIFF_CNT=0

for t in $TIMES; do
    COUNT=$((COUNT + 1))
    TOTAL=$(awk -v a="$TOTAL" -v b="$t" 'BEGIN {print a + b}')
    MIN=$(awk -v a="$MIN" -v b="$t" 'BEGIN {print (a < b ? a : b)}')
    MAX=$(awk -v a="$MAX" -v b="$t" 'BEGIN {print (a > b ? a : b)}')
    if [ -n "$PREV" ]; then
        D=$(awk -v a="$t" -v b="$PREV" 'BEGIN {d = a - b; print (d < 0 ? -d : d)}')
        DIFF_SUM=$(awk -v a="$DIFF_SUM" -v b="$D" 'BEGIN {print a + b}')
        DIFF_CNT=$((DIFF_CNT + 1))
    fi
    PREV="$t"
done

AVG=0
JITTER=0
if [ "$COUNT" -gt 0 ]; then
    AVG=$(awk -v a="$TOTAL" -v b="$COUNT" 'BEGIN {printf "%.1f", a / b}')
    [ "$MIN" = "99999" ] && MIN=0
else
    MIN=0
fi

if [ "$DIFF_CNT" -gt 0 ]; then
    JITTER=$(awk -v a="$DIFF_SUM" -v b="$DIFF_CNT" 'BEGIN {printf "%.1f", a / b}')
fi

LOSS=$(echo "$PING_RAW" | grep -o '[0-9]*% packet loss' | cut -d'%' -f1)
[ -z "$LOSS" ] && LOSS=0

# 2. DOWNLOAD SPEEDTEST (Phase 2/3 - Downlink first)
cat << JSON > "$OUTPUT_FILE"
{
  "state": "running",
  "step": "download",
  "step_label": "[Phase 2/3] Measuring download speed ($((DOWN_BYTES / 1000000)) MB)...",
  "server": "$SERVER_NAME",
  "location": "$LOCATION",
  "target": "$PING_TARGET",
  "band": "$ACTIVE_BAND",
  "operator": "$ACTIVE_OPERATOR",
  "rsrp": "$ACTIVE_RSRP",
  "sinr": "$ACTIVE_SINR",
  "ping_min": $MIN,
  "ping_avg": $AVG,
  "ping_max": $MAX,
  "jitter": $JITTER,
  "packet_loss": $LOSS,
  "download_mbps": 0,
  "upload_mbps": 0,
  "progress": 30
}
JSON

T_START=$(date +%s)
RX_START=$(cat /sys/class/net/wwan0/statistics/rx_bytes 2>/dev/null || echo 0)

uclient-fetch -q -O /dev/null "$DOWN_URL"

T_END=$(date +%s)
RX_END=$(cat /sys/class/net/wwan0/statistics/rx_bytes 2>/dev/null || echo 0)

DT_SEC=$((T_END - T_START))
[ "$DT_SEC" -le 0 ] && DT_SEC=1
DRX=$((RX_END - RX_START))
[ "$DRX" -lt 0 ] && DRX=0

DL_MBPS=$(awk -v bytes="$DRX" -v sec="$DT_SEC" 'BEGIN {if (sec > 0) printf "%.2f", (bytes * 8.0) / (sec * 1000000.0); else print "0"}')

# 3. UPLOAD SPEEDTEST (Phase 3/3 - Uplink after Downlink, 1:1 Payload)
cat << JSON > "$OUTPUT_FILE"
{
  "state": "running",
  "step": "upload",
  "step_label": "[Phase 3/3] Measuring upload speed ($((UP_COUNT * 64 / 1024)) MB 1:1 Payload)...",
  "server": "$SERVER_NAME",
  "location": "$LOCATION",
  "target": "$PING_TARGET",
  "band": "$ACTIVE_BAND",
  "operator": "$ACTIVE_OPERATOR",
  "rsrp": "$ACTIVE_RSRP",
  "sinr": "$ACTIVE_SINR",
  "ping_min": $MIN,
  "ping_avg": $AVG,
  "ping_max": $MAX,
  "jitter": $JITTER,
  "packet_loss": $LOSS,
  "download_mbps": $DL_MBPS,
  "upload_mbps": 0,
  "progress": 65
}
JSON

PAYLOAD_FILE="/tmp/.speedtest_payload.bin"
dd if=/dev/urandom of="$PAYLOAD_FILE" bs=64k count=$UP_COUNT 2>/dev/null

T_START_U=$(date +%s)
TX_START=$(cat /sys/class/net/wwan0/statistics/tx_bytes 2>/dev/null || echo 0)

uclient-fetch --timeout=30 --post-file="$PAYLOAD_FILE" -O /dev/null -q "$UP_URL" 2>/dev/null || true
rm -f "$PAYLOAD_FILE"

T_END_U=$(date +%s)
TX_END=$(cat /sys/class/net/wwan0/statistics/tx_bytes 2>/dev/null || echo 0)

DT_SEC_U=$((T_END_U - T_START_U))
[ "$DT_SEC_U" -le 0 ] && DT_SEC_U=1
DTX=$((TX_END - TX_START))
[ "$DTX" -lt 0 ] && DTX=0

UL_MBPS=$(awk -v bytes="$DTX" -v sec="$DT_SEC_U" 'BEGIN {if (sec > 0) printf "%.2f", (bytes * 8.0) / (sec * 1000000.0); else print "0"}')

TIMESTAMP=$(date "+%Y-%m-%d %H:%M:%S")

cat << JSON > "$OUTPUT_FILE"
{
  "state": "completed",
  "step": "done",
  "step_label": "Speedtest Benchmark Completed (1:1 Ratio)",
  "timestamp": "$TIMESTAMP",
  "server": "$SERVER_NAME",
  "location": "$LOCATION",
  "target": "$PING_TARGET",
  "band": "$ACTIVE_BAND",
  "operator": "$ACTIVE_OPERATOR",
  "rsrp": "$ACTIVE_RSRP",
  "sinr": "$ACTIVE_SINR",
  "ping_min": $MIN,
  "ping_avg": $AVG,
  "ping_max": $MAX,
  "jitter": $JITTER,
  "packet_loss": $LOSS,
  "download_mbps": $DL_MBPS,
  "upload_mbps": $UL_MBPS,
  "rx_bytes": $DRX,
  "tx_bytes": $DTX,
  "dl_sec": $DT_SEC,
  "ul_sec": $DT_SEC_U,
  "progress": 100
}
JSON

rm -f "$PID_FILE"

append_history
